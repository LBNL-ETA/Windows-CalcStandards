{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "description": "Base: standard configure with no overrides. Inherited by default-debug and default-release.",
            "binaryDir": "${sourceDir}/build/default"
        },
        {
            "name": "default-debug",
            "displayName": "Default (Debug)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/default-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "default-release",
            "displayName": "Default (Release)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/default-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "local",
            "hidden": true,
            "description": "Base: placeholder for sibling-working-copy overrides. This repository has no LBNL dependencies, so `local` is currently identical to `default`. Inherited by local-debug, local-release, and personal compiler presets so the convention matches the rest of the LBNL repo set.",
            "inherits": "default"
        },
        {
            "name": "local-debug",
            "displayName": "Local (Debug)",
            "inherits": "local",
            "binaryDir": "${sourceDir}/build/local-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "local-release",
            "displayName": "Local (Release)",
            "inherits": "local",
            "binaryDir": "${sourceDir}/build/local-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}
